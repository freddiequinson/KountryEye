[Unit]
Description=Kountry Eyecare Backend API (STAGING)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/kountryeye-staging/backend
Environment="PATH=/var/www/kountryeye-staging/backend/venv/bin"
EnvironmentFile=/var/www/kountryeye-staging/backend/.env
ExecStart=/var/www/kountryeye-staging/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
